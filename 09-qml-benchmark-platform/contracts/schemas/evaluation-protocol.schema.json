{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paths.example/contracts/qml/evaluation-protocol.schema.json",
  "title": "EvaluationProtocol",
  "type": "object",
  "required": ["schema_version", "protocol_id", "split", "seeds", "repetitions", "max_samples", "max_features", "max_vqc_iterations", "metrics"],
  "properties": {
    "schema_version": {"const": "qml.evaluation-protocol.v1"},
    "split": {"const": "validation"},
    "seeds": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "integer"}},
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 3},
    "max_samples": {"type": "integer", "maximum": 32},
    "max_features": {"type": "integer", "maximum": 8},
    "max_vqc_iterations": {"type": "integer", "minimum": 1, "maximum": 8}
  }
}
