{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paths.example/contracts/qml/evidence-bundle.schema.json",
  "title": "EvidenceBundle",
  "type": "object",
  "required": ["schema_version", "sha256", "evidence"],
  "properties": {
    "schema_version": {"const": "qml.evidence-bundle.v1"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {"$ref": "encoding-preview.schema.json"}
  }
}
