{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paths.example/contracts/qml/noise-limitations-report.schema.json",
  "title": "NoiseLimitationsReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "comparison_id", "snapshot_id", "protocol", "profiles", "mitigation", "runs", "uncertainty", "trainability", "findings", "limitations", "provenance"],
  "properties": {
    "schema_version": {"const": "qml.noise-limitations-report.v1"},
    "report_id": {"type": "string", "pattern": "^noise-report-[a-f0-9]{16}$"},
    "comparison_id": {"type": "string", "pattern": "^noise-comparison-[a-f0-9]{16}$"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "protocol": {
      "type": "object",
      "required": ["schema_version", "protocol_id", "seeds", "shots", "noise_strength", "readout_error", "max_depth", "model_id", "split"]
    },
    "profiles": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "noise-profile.schema.json"}},
    "mitigation": {"$ref": "mitigation-spec.schema.json"},
    "runs": {"type": "array", "minItems": 4},
    "uncertainty": {"type": "array", "minItems": 12},
    "trainability": {"type": "array", "minItems": 1, "maxItems": 8},
    "findings": {"type": "array", "minItems": 4, "items": {"$ref": "limitation-finding.schema.json"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "provenance": {
      "type": "object",
      "required": ["dataset_sha256", "preprocessing_fitted_on", "paired_factors", "hardware_jobs", "quantum_advantage_claimed", "error_correction_claimed"],
      "properties": {
        "hardware_jobs": {"const": 0},
        "quantum_advantage_claimed": {"const": false},
        "error_correction_claimed": {"const": false}
      }
    }
  }
}
