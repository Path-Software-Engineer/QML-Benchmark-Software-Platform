{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paths.example/contracts/qml/source-assessment.schema.json",
  "title": "SourceAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_project", "status", "importable", "reason", "observed_artifacts", "quantum_advantage_claimed", "executable_content_imported"],
  "properties": {
    "schema_version": {"const": "qml.source-assessment.v1"},
    "source_project": {"const": "Path-AI-Engineer/53-quantum-noise-and-qml-limitations-lab"},
    "status": {"const": "conceptual-only"},
    "importable": {"const": false},
    "reason": {"type": "string", "minLength": 1},
    "observed_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "quantum_advantage_claimed": {"const": false},
    "executable_content_imported": {"const": false}
  }
}
